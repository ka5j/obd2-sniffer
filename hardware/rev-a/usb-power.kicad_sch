	(text "The board is powered from the laptop's USB port only (PWR-5).\nThe car's 12 V supply has no connection to the board (PWR-8)."
		(exclude_from_sim no)
		(at 15.24 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2cfc4273-040d-5ad2-92da-d229bb42bb7b")
	)
	(text "Total capacitance on the USB 5 V stays under 10 uF, the limit a USB device may present when plugged in.\nThe transceivers take the 5 V directly and need at least 4.5 V: the fuse drops about 35 mV at 250 mA."
		(exclude_from_sim no)
		(at 15.24 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3920b625-d26f-58fc-b413-fbd57dbff446")
	)
	(text "On whenever 3.3 V is present,\nwith or without firmware (USE-3)."
		(exclude_from_sim no)
		(at 236.22 59.69 0)
		(effects
