	)
	(text "Hold BOOT while pressing RESET to start the chip's USB bootloader (USE-4).\nBOOT0 is low otherwise, and BOOT1 (PB2) is always low, as the bootloader needs."
		(exclude_from_sim no)
		(at 27.94 204.47 0)
		(effects
